AWS_SECRET_ACCESS_KEY=
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=

# Admin Master Credentials (Initial Boot)
CROWNDESK_ADMIN_EMAIL=
CROWNDESK_INITIAL_ADMIN_PASSWORD=

# SMTP Mail Server (Optional for Password Reset OTP / Email Alerts)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=

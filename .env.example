# Server Configuration
PORT=3000
NODE_ENV=production

# Session & Security
SESSION_SECRET=

# Google Gemini API
GEMINI_API_KEY=

# Supabase (Database & Storage Vault)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AWS S3 / Cloud Object Storage (Optional File Vault)
AWS_S3_BUCKET=

{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and role configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["CUSTOMER", "DESIGNER_EMPLOYEE", "ADMIN", "SUPER_ADMIN"] },
        "clinicName": { "type": "string" },
        "phone": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "DentalCase": {
      "title": "DentalCase",
      "description": "CAD design case submitted by doctor or dental lab",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "caseId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "doctorName": { "type": "string" },
        "patientName": { "type": "string" },
        "toothNumbers": { "type": "string" },
        "restorationType": { "type": "string" },
        "material": { "type": "string" },
        "shade": { "type": "string" },
        "status": { "type": "string", "enum": ["NEW", "RECEIVED", "ASSIGNED", "IN_DESIGN", "QC", "APPROVAL", "REVISION", "COMPLETED", "DELIVERED"] },
        "assignedDesignerId": { "type": "string" },
        "assignedDesignerName": { "type": "string" },
        "unitsCount": { "type": "number" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["UNPAID", "PAID", "REFUNDED", "PENDING_VERIFICATION"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["caseId", "customerId", "status"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Financial ledger record for case transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "caseId": { "type": "string" },
        "customerId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "gateway": { "type": "string" },
        "status": { "type": "string", "enum": ["SUCCESS", "PENDING", "PENDING_VERIFICATION", "FAILED", "REFUNDED"] },
        "transactionId": { "type": "string" },
        "invoiceId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["caseId", "customerId", "amount", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and activity audit entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "actor": { "type": "string" },
        "actorRole": { "type": "string" },
        "target": { "type": "string" },
        "details": { "type": "string" },
        "ip": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "actor", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile records with role and contact info"
    },
    "/cases/{caseDocId}": {
      "schema": { "$ref": "#/entities/DentalCase" },
      "description": "Digital dental CAD design orders"
    },
    "/payments/{paymentDocId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Payment records for case transactions"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable audit trails for administrative tracking"
    }
  }
}
